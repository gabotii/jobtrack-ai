# Copy to .env and replace every value. Never commit .env.

# Database password used by the db and api containers.
POSTGRES_PASSWORD=change-me-postgres-password

# HMAC key for access tokens: at least 32 random characters, e.g.
#   openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-of-at-least-32-chars

# Optional: enables AI CV analysis with Claude (Anthropic). Leave empty to use only the local analyzer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Port where the web app is published on the host.
WEB_PORT=8080

# Browsers accept Secure cookies on http://localhost. Set to false only when serving plain HTTP on another host.
AUTH_COOKIE_SECURE=true

# Set to true to expose the API documentation at http://localhost:8080/swagger.
SWAGGER_ENABLED=false

# Password for the optional demo account (docker compose run --rm -e ASPNETCORE_ENVIRONMENT=Demo api seed-demo).
DEMO_PASSWORD=
